    },
    "display": {
        "formats": {
            "send((uint32 dstEid,bytes32 to,uint256 amountLD,uint256 minAmountLD,bytes extraOptions,bytes composeMsg,bytes oftCmd) _sendParam,(uint256 nativeFee,uint256 lzTokenFee) _fee,address _refundAddress)": {
                "intent": "Bridge vTAO",
                "fields": [
                    {
                        "path": "#._sendParam.dstEid",
                        "label": "Destination network",
                        "format": "enum",
                        "params": {
                            "$ref": "$.metadata.enums.layerZeroEndpoint"
                        },
                        "visible": "always"
                    },
                    {
                        "path": "#._sendParam.to",
                        "label": "Recipient",
                        "format": "raw",
                        "visible": "always"
                    },
                    {
                        "path": "#._sendParam.amountLD",
                        "label": "Amount",
                        "format": "tokenAmount",
                        "params": {
                            "tokenPath": "@.to"
                        },
                        "visible": "always"
                    },
                    {
                        "path": "#._sendParam.minAmountLD",
                        "label": "Minimum received",
                        "format": "tokenAmount",
                        "params": {
                            "tokenPath": "@.to"
                        },
                        "visible": "always"
                    },
                    {
                        "path": "@.value",
                        "label": "Bridge fee",
                        "format": "amount",
                        "visible": "always"
                    },
                    {
                        "path": "#._refundAddress",
                        "label": "Refund address",
                        "format": "addressName",
                        "params": {
                            "types": ["eoa", "wallet"],
                            "sources": ["local", "ens"]
                        },
                        "visible": "always"
                    },
                    {
                        "path": "#._sendParam.extraOptions",
                        "label": "Options",
                        "visible": "never"
                    },
                    {
                        "path": "#._sendParam.composeMsg",
                        "label": "Compose message",
                        "visible": "never"
                    },
                    {
                        "path": "#._sendParam.oftCmd",
                        "label": "OFT command",
                        "visible": "never"
                    },
                    {
                        "path": "#._fee.nativeFee",
                        "label": "Native fee",
                        "visible": "never"
                    },
                    {
                        "path": "#._fee.lzTokenFee",
                        "label": "LayerZero token fee",
                        "visible": "never"
                    }
                ]
            }
        }
    }
}

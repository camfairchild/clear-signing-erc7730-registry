    "metadata": {
        "owner": "Latent",
        "contractName": "vTAO LayerZero OFT",
        "info": {
            "url": "https://tao.app/bridge"
        },
        "token": {
            "name": "Virtual TAO",
            "ticker": "vTAO",
            "decimals": 18
        },
        "enums": {
            "layerZeroEndpoint": {
                "30101": "Ethereum",
                "30102": "BNB Smart Chain",
                "30106": "Avalanche",
                "30109": "Polygon",
                "30110": "Arbitrum",
                "30111": "Optimism",
                "30145": "Gnosis",
                "30184": "Base",
                "30362": "Berachain",
                "30374": "Bittensor EVM"
